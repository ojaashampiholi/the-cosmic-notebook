{
  "name": "the-cosmic-notebook",
  "description": "The Cosmic Notebook — clear, source-backed notes on astronomy, astrophysics, physics, and space science.",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "predev": "npm run content:update",
    "dev": "astro dev",
    "content:update": "npm run llms:update && npm run visuals:update && npm run images:check",
    "images:check": "node scripts/check-note-images.mjs",
    "llms:update": "node scripts/generate-llms.mjs",
    "visuals:update": "node scripts/generate-topic-visuals.mjs",
    "prebuild": "npm run content:update",
    "build": "astro check && astro build",
    "postbuild": "node scripts/check-discovery.mjs --dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.13.0",
    "marked": "^18.0.14",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  }
}
