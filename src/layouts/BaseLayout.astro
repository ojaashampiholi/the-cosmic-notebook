---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  AUTHOR_SAME_AS,
  ORG_ID,
  PERSON_ID,
  SITE_AUTHOR,
  SITE_CANONICAL_ORIGIN,
  SITE_DESCRIPTION,
  SITE_NAME,
  WEBSITE_ID,
  authorJsonLd,
  organizationJsonLd,
  websiteJsonLd,
  withBase,
} from "../lib/site.ts";
import "../styles/theme.css";

const {
  title = `${SITE_NAME} by ${SITE_AUTHOR}`,
  description = SITE_DESCRIPTION,
  image = "/the-cosmic-notebook/images/topic-previews/cosmic-notebook.png",
  imageAlt,
  type = "website",
  noindex = false,
  publishedTime,
  section,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const pictureAlt = imageAlt || title;
const llmsUrl = new URL(withBase("llms.txt"), Astro.site);

const aboutUrl = `${SITE_CANONICAL_ORIGIN}/about/`;

function asGraphNode(value: unknown) {
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    return null;
  }

  const node = { ...(value as Record<string, unknown>) };
  delete node["@context"];
  return node;
}

const extraNode = asGraphNode(jsonLd);
const graph: Record<string, unknown>[] = [
  authorJsonLd(),
  organizationJsonLd(),
  websiteJsonLd(),
];

if (extraNode) {
  graph.push(extraNode);
} else {
  graph.push({
    "@type": "WebPage",
    "@id": canonical.href,
    url: canonical.href,
    name: title,
    description,
    inLanguage: "en",
    isPartOf: { "@id": WEBSITE_ID },
    author: { "@id": PERSON_ID },
    publisher: { "@id": ORG_ID },
    about: { "@id": ORG_ID },
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const key = "cosmic-notebook-theme";
        let theme = "dark";
        try {
          const stored = localStorage.getItem(key);
          if (stored === "light" || stored === "dark") {
            theme = stored;
          } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            theme = "light";
          }
        } catch {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <meta name="google-site-verification" content="9UI2VteLdPcUNuEx0c7Z9WpnYBxwOrwaXBYPR-IpWtY" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large"
      }
    />
    <meta name="theme-color" content="#090d18" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="text/plain"
      title="LLM-readable catalogue"
      href={llmsUrl}
    />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="author" href={aboutUrl} />
    {
      AUTHOR_SAME_AS.map((profile) => (
        <link rel="me" href={profile} />
      ))
    }
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={pictureAlt} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && (
        <meta property="article:author" content={aboutUrl} />
      )
    }
    {
      type === "article" && section && (
        <meta property="article:section" content={section} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={pictureAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    {
      import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
          })}
        ></script>
      )
    }
    <title>{title}</title>
  </head>

  <body class:list={[{ "is-reading": type === "article" }]}>
    <div class="page-sky" aria-hidden="true">
      <span class="sky-orb sky-sun"></span>
      <span class="sky-orb sky-moon"></span>
      <span class="sky-orb sky-planet sky-planet-one"></span>
      <span class="sky-orb sky-planet sky-planet-two"></span>
      <span class="sky-orb sky-planet sky-saturn"></span>
      <span class="sky-telescope"></span>
    </div>

    <main>
      <SiteHeader />
      <slot />
      <SiteFooter />
    </main>
  </body>
</html>
