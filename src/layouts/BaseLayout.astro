---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  SITE_AUTHOR,
  SITE_CANONICAL_ORIGIN,
  SITE_DESCRIPTION,
  SITE_NAME,
  withBase,
} from "../lib/site.ts";
import "../styles/theme.css";

const {
  title = `${SITE_NAME} | Astronomy and physics notes`,
  description = SITE_DESCRIPTION,
  image = "/the-cosmic-notebook/images/topic-previews/cosmic-notebook.png",
  type = "website",
  noindex = false,
  publishedTime,
  section,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const llmsUrl = new URL(withBase("llms.txt"), Astro.site);

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: `${SITE_CANONICAL_ORIGIN}/`,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
  },
};

const structuredData = jsonLd ?? defaultJsonLd;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const key = "cosmic-notebook-theme";
        let theme = "dark";
        try {
          const stored = localStorage.getItem(key);
          if (stored === "light" || stored === "dark") {
            theme = stored;
          } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            theme = "light";
          }
        } catch {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <meta name="google-site-verification" content="9UI2VteLdPcUNuEx0c7Z9WpnYBxwOrwaXBYPR-IpWtY" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large"
      }
    />
    <meta name="theme-color" content="#090d18" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="text/plain"
      title="LLM-readable catalogue"
      href={llmsUrl}
    />
    <meta name="author" content={SITE_AUTHOR} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && (
        <meta property="article:author" content={SITE_AUTHOR} />
      )
    }
    {
      type === "article" && section && (
        <meta property="article:section" content={section} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    {
      import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
          })}
        ></script>
      )
    }
    <title>{title}</title>
  </head>

  <body>
    <div class="page-sky" aria-hidden="true">
      <span class="sky-orb sky-sun"></span>
      <span class="sky-orb sky-moon"></span>
      <span class="sky-orb sky-planet sky-planet-one"></span>
      <span class="sky-orb sky-planet sky-planet-two"></span>
      <span class="sky-orb sky-planet sky-saturn"></span>
      <span class="sky-telescope"></span>
    </div>

    <main>
      <SiteHeader />
      <slot />
      <SiteFooter />
    </main>
  </body>
</html>
