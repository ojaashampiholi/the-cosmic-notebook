---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts")).sort(
  (first, second) => second.data.date.getTime() - first.data.date.getTime()
);

const latestPostLimit = 10;

const topics = [
  ...new Set(
    posts.flatMap((post) =>
      post.data.topic
        .split("/")
        .map((topic) => topic.trim())
        .filter(Boolean)
    )
  ),
].sort((first, second) => first.localeCompare(second));

const topicCounts = new Map(
  topics.map((topic) => [
    topic,
    posts.filter((post) =>
      post.data.topic
        .split("/")
        .map((item) => item.trim())
        .includes(topic)
    ).length,
  ])
);

const buildDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Kolkata",
}).format(new Date());

const buildTime = new Intl.DateTimeFormat("en-IN", {
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
  timeZone: "Asia/Kolkata",
  timeZoneName: "short",
}).format(new Date());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function getTopics(topic: string) {
  return topic
    .split("/")
    .map((item) => item.trim())
    .filter(Boolean);
}
---

<BaseLayout>
  <header class="site-header">
    <a class="site-brand" href={import.meta.env.BASE_URL}>
      Orbital Notes
    </a>

    <nav class="site-nav" aria-label="Find Ojaas elsewhere">
      <a
        href="https://www.linkedin.com/in/ojaashampiholi/"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn
      </a>

      <a
        href="https://medium.com/@ojaashampiholi"
        target="_blank"
        rel="noreferrer"
      >
        Medium
      </a>

      <a
        href="https://substack.com/@ojaashampiholi"
        target="_blank"
        rel="noreferrer"
      >
        Substack
      </a>
    </nav>
  </header>

  <p class="eyebrow">Astronomy · Physics · Space science</p>

  <h1>Orbital Notes</h1>

  <p>
    Clear, curious notes on the forces, worlds, and ideas that shape our
    universe.
  </p>

  <section class="topic-filter-section" data-post-browser>
    <div class="filter-heading">
      <div>
        <p class="eyebrow">Browse by topic</p>
        <h2>Choose one or more fields of curiosity</h2>
      </div>
    </div>

    <div
      class="topic-filters"
      role="group"
      aria-label="Filter posts by topic"
    >
      <button
        class="topic-filter is-active"
        type="button"
        data-filter-all
        aria-pressed="true"
      >
        All posts <span>{posts.length}</span>
      </button>

      {
        topics.map((topic) => (
          <button
            class="topic-filter"
            type="button"
            data-topic-filter={topic}
            aria-pressed="false"
          >
            {topic} <span>{topicCounts.get(topic)}</span>
          </button>
        ))
      }
    </div>

    <p class="filter-status" data-filter-status aria-live="polite">
      Showing the 10 newest notes.
    </p>

    <ul class="archive" data-post-list>
      {
        posts.map((post, index) => {
          const primarySource = post.data.sources[0];
          const postTopics = getTopics(post.data.topic);

          return (
            <li
              class="post-card"
              data-post-card
              data-topics={JSON.stringify(postTopics)}
              hidden={index >= latestPostLimit}
            >
              <div class="topic-chip-list" aria-label="Post topics">
                {
                  postTopics.map((topic) => (
                    <span class="topic-chip">{topic}</span>
                  ))
                }
              </div>

              <h2>
                {
                  primarySource ? (
                    <a
                      href={primarySource.url}
                      target="_blank"
                      rel="noreferrer"
                      title={`Open source: ${primarySource.label}`}
                    >
                      {post.data.title}
                    </a>
                  ) : (
                    post.data.title
                  )
                }
              </h2>

              <p class="eyebrow">Published</p>
              <p class="card-value">{formatDate(post.data.date)}</p>

              <p class="eyebrow">Freshness</p>
              <p class="card-value">{post.data.freshness}</p>

              <p class="eyebrow">Summary</p>
              <p class="card-value">{post.data.excerpt}</p>

              <p class="eyebrow">Why it matters</p>
              <p class="card-value">{post.data.whyItMatters}</p>

              <p class="eyebrow">Sources</p>

              <ul class="source-list">
                {
                  post.data.sources.map((source) => (
                    <li>
                      <a href={source.url} target="_blank" rel="noreferrer">
                        {source.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
          );
        })
      }
    </ul>

    <p class="empty-state" data-empty-state hidden>
      No notes match those topics yet.
    </p>

    <div
      class="archive-prompt"
      data-archive-prompt
      data-archive-base={`${import.meta.env.BASE_URL}archive/`}
      hidden
    >
      <p data-archive-message></p>

      <a class="archive-link" data-archive-link href={`${import.meta.env.BASE_URL}archive/`}>
        Explore the archive →
      </a>
    </div>
  </section>

  <section class="reflection" aria-labelledby="reflection-heading">
    <p class="eyebrow">A personal note</p>

    <h2 id="reflection-heading">Why I keep looking up</h2>

    <p>
      Space and physics have long been subjects I return to out of pure
      fascination, even though I have never studied either deeply in a formal
      sense. I often follow a new result, a mission update, or a strange
      astronomical observation simply because it makes the universe feel larger
      and more intelligible at the same time. These notes are my way of slowing
      down, making sense of what I learn, and keeping a small public record of
      that curiosity. I hope they help someone else discover a question worth
      following too.
    </p>

    <div class="elsewhere">
      <p class="eyebrow">Elsewhere on the internet</p>

      <div class="creator-links">
        <a
          href="https://www.linkedin.com/in/ojaashampiholi/"
          target="_blank"
          rel="noreferrer"
        >
          <strong>LinkedIn</strong>
          <span>
            Shorter tech blogs on AI, data, engineering, and the ideas I am
            actively exploring.
          </span>
        </a>

        <a
          href="https://medium.com/@ojaashampiholi"
          target="_blank"
          rel="noreferrer"
        >
          <strong>Medium</strong>
          <span>
            Longer articles for when an idea needs more room to unfold,
            challenge assumptions, and connect the dots.
          </span>
        </a>

        <a
          href="https://substack.com/@ojaashampiholi"
          target="_blank"
          rel="noreferrer"
        >
          <strong>Substack</strong>
          <span>
            Short fictional stories for readers who enjoy imagined worlds,
            uneasy questions, and a little narrative escape.
          </span>
        </a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-line">
      <span>Maintained by Ojaas Hampiholi</span>
      <span class="footer-divider" aria-hidden="true">·</span>
      <span>Open access astronomy and physics notes</span>
    </div>

    <p class="last-updated">
      Updated {buildDate} · {buildTime}
    </p>
  </footer>
</BaseLayout>

<script>
  const browser = document.querySelector<HTMLElement>("[data-post-browser]");

  if (browser) {
    const postCards = Array.from(
      browser.querySelectorAll<HTMLElement>("[data-post-card]")
    );

    const topicButtons = Array.from(
      browser.querySelectorAll<HTMLButtonElement>("[data-topic-filter]")
    );

    const allPostsButton = browser.querySelector<HTMLButtonElement>(
      "[data-filter-all]"
    );

    const filterStatus = browser.querySelector<HTMLElement>(
      "[data-filter-status]"
    );

    const emptyState = browser.querySelector<HTMLElement>(
      "[data-empty-state]"
    );

    const archivePrompt = browser.querySelector<HTMLElement>(
      "[data-archive-prompt]"
    );

    const archiveMessage = browser.querySelector<HTMLElement>(
      "[data-archive-message]"
    );

    const archiveLink = browser.querySelector<HTMLAnchorElement>(
      "[data-archive-link]"
    );

    const selectedTopics = new Set<string>();
    const maximumVisiblePosts = 10;

    function cardMatchesSelectedTopics(card: HTMLElement) {
      if (selectedTopics.size === 0) {
        return true;
      }

      const topics = JSON.parse(card.dataset.topics ?? "[]") as string[];

      return topics.some((topic) => selectedTopics.has(topic));
    }

    function updateArchiveLink() {
      if (!archivePrompt || !archiveLink || !archiveMessage) {
        return;
      }

      const matchingCards = postCards.filter(cardMatchesSelectedTopics);
      const remainingCount = Math.max(
        matchingCards.length - maximumVisiblePosts,
        0
      );

      archivePrompt.hidden = remainingCount === 0;

      if (remainingCount === 0) {
        return;
      }

      archiveMessage.textContent =
        remainingCount === 1
          ? "There is 1 more matching note in the archive."
          : `There are ${remainingCount} more matching notes in the archive.`;

      const basePath = archivePrompt.dataset.archiveBase ?? "/archive/";
      const parameters = new URLSearchParams();

      if (selectedTopics.size > 0) {
        parameters.set("topics", [...selectedTopics].join(","));
      }

      archiveLink.href = parameters.size
        ? `${basePath}?${parameters.toString()}`
        : basePath;
    }

    function applyFilters() {
      const matchingCards = postCards.filter(cardMatchesSelectedTopics);

      postCards.forEach((card) => {
        card.hidden = true;
      });

      matchingCards
        .slice(0, maximumVisiblePosts)
        .forEach((card) => {
          card.hidden = false;
        });

      topicButtons.forEach((button) => {
        const topic = button.dataset.topicFilter ?? "";
        const isSelected = selectedTopics.has(topic);

        button.classList.toggle("is-active", isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
      });

      const showingAllPosts = selectedTopics.size === 0;

      if (allPostsButton) {
        allPostsButton.classList.toggle("is-active", showingAllPosts);
        allPostsButton.setAttribute("aria-pressed", String(showingAllPosts));
      }

      if (emptyState) {
        emptyState.hidden = matchingCards.length !== 0;
      }

      if (filterStatus) {
        if (matchingCards.length === 0) {
          filterStatus.textContent = "No matching notes found.";
        } else if (matchingCards.length <= maximumVisiblePosts) {
          filterStatus.textContent = `Showing all ${matchingCards.length} matching notes.`;
        } else {
          filterStatus.textContent = `Showing the newest ${maximumVisiblePosts} of ${matchingCards.length} matching notes.`;
        }
      }

      updateArchiveLink();
    }

    allPostsButton?.addEventListener("click", () => {
      selectedTopics.clear();
      applyFilters();
    });

    topicButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const topic = button.dataset.topicFilter;

        if (!topic) {
          return;
        }

        if (selectedTopics.has(topic)) {
          selectedTopics.delete(topic);
        } else {
          selectedTopics.add(topic);
        }

        applyFilters();
      });
    });

    applyFilters();
  }
</script>

<style>
  :global(main) {
    width: min(1360px, calc(100% - 48px));
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 72px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(179, 194, 232, 0.16);
  }

  .site-brand {
    color: #f1f4fb;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav,
  .topic-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-nav a,
  .topic-filter {
    padding: 8px 12px;
    color: #aebdff;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    font: 700 0.78rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease;
  }

  .site-nav a:hover,
  .topic-filter:hover,
  .topic-filter.is-active {
    color: #f1f4fb;
    background: rgba(174, 189, 255, 0.1);
    border-color: rgba(174, 189, 255, 0.3);
  }

  .topic-filter span {
    margin-left: 3px;
    color: #8f9bb7;
  }

  .topic-filter-section {
    margin-top: 52px;
  }

  .filter-heading h2 {
    margin: 5px 0 18px;
    color: #f1f4fb;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.55rem;
    letter-spacing: -0.025em;
    text-transform: none;
  }

  .filter-status {
    margin: 18px 0 0;
    color: #8f9bb7;
    font: 0.86rem/1.5 Arial, sans-serif;
  }

  .archive {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 24px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .archive .post-card {
    position: relative;
    min-width: 0;
    padding: clamp(28px, 4vw, 44px);
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.045), transparent 42%),
      #121a2b;
    border: 1px solid rgba(179, 194, 232, 0.16);
    border-radius: 20px;
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.045);
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .archive .post-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(to bottom, #aebdff, #8c72cc 55%, #d49c6a);
    content: "";
  }

  .archive .post-card:hover {
    border-color: rgba(174, 189, 255, 0.42);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.36);
    transform: translateY(-4px);
  }

  .topic-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
  }

  .topic-chip {
    padding: 5px 8px;
    color: #aebdff;
    background: rgba(174, 189, 255, 0.08);
    border: 1px solid rgba(174, 189, 255, 0.14);
    border-radius: 999px;
    font: 700 0.68rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
  }

  .post-card h2 {
    margin: 0 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.7rem, 3.5vw, 2.45rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-transform: none;
  }

  .post-card h2 a {
    color: #f1f4fb;
    text-decoration: none;
  }

  .post-card h2 a:hover,
  .post-card .source-list a:hover {
    color: #b9c6ff;
  }

  .post-card .eyebrow {
    margin: 0 0 4px;
    color: #aebdff;
  }

  .card-value {
    margin: 3px 0 22px;
    color: #b9c2d3;
  }

  .post-card .source-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 7px 0 0;
    padding: 0;
    list-style: none;
  }

  .post-card .source-list li {
    padding: 0;
    border: 0;
    font: inherit;
  }

  .post-card .source-list li:not(:last-child)::after {
    margin: 0 0.55rem;
    color: #63708d;
    content: "·";
  }

  .post-card .source-list a {
    color: #c7d1ff;
    font: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .empty-state,
  .archive-prompt {
    margin: 28px auto 0;
    padding: 24px;
    color: #b9c2d3;
    background: rgba(174, 189, 255, 0.06);
    border: 1px solid rgba(174, 189, 255, 0.16);
    border-radius: 14px;
    text-align: center;
  }

  .archive-prompt p {
    margin: 0 0 12px;
  }

  .archive-link {
    color: #c7d1ff;
    font: 700 0.88rem/1.4 Arial, sans-serif;
    text-underline-offset: 3px;
  }

  .reflection {
    max-width: 820px;
    margin: 96px auto 0;
    padding: clamp(30px, 5vw, 52px);
    background: rgba(18, 26, 43, 0.7);
    border: 1px solid rgba(179, 194, 232, 0.15);
    border-radius: 20px;
  }

  .reflection .eyebrow,
  .elsewhere > .eyebrow {
    margin: 0 0 8px;
    color: #aebdff;
  }

  .reflection h2 {
    margin: 0 0 18px;
    color: #f1f4fb;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    text-transform: none;
  }

  .reflection > p {
    color: #c2cad9;
  }

  .elsewhere {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid rgba(179, 194, 232, 0.16);
  }

  .creator-links {
    display: grid;
    gap: 10px;
  }

  .creator-links a {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    color: #b9c2d3;
    background: rgba(174, 189, 255, 0.035);
    border: 1px solid rgba(179, 194, 232, 0.12);
    border-radius: 12px;
    text-decoration: none;
  }

  .creator-links strong {
    color: #dce3ff;
    font: 700 0.9rem/1.4 Arial, sans-serif;
  }

  .creator-links span {
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .site-footer {
    margin-top: 40px;
    padding: 24px 0 0;
    border-top: 1px solid rgba(179, 194, 232, 0.16);
    text-align: center;
  }

  .footer-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    color: #aeb8cc;
    font: 0.84rem/1.6 Arial, sans-serif;
  }

  .footer-divider {
    color: #63708d;
  }

  .last-updated {
    margin: 5px 0 0;
    color: #7f8ba5;
    font: 0.76rem/1.5 Arial, sans-serif;
  }

  @media (max-width: 900px) {
    :global(main) {
      width: min(820px, calc(100% - 40px));
    }

    .archive {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (max-width: 600px) {
    :global(main) {
      width: min(100% - 32px, 820px);
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 42px;
    }

    .archive .post-card,
    .reflection {
      padding: 28px 24px 30px;
      border-radius: 16px;
    }
  }
</style>