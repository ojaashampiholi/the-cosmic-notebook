---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedNotes from "../../components/RelatedNotes.astro";
import {
  markdownToPlain,
  renderMarkdown,
  stripMarkdownSections,
} from "../../lib/markdown.ts";
import { resolveNoteImage } from "../../lib/note-image.ts";
import { relatedPosts } from "../../lib/posts.ts";
import { topicVisual } from "../../lib/topic-visuals.ts";
import {
  AUTHOR_SAME_AS,
  ORG_ID,
  PERSON_ID,
  SITE_AUTHOR,
  SITE_CANONICAL_ORIGIN,
  SITE_NAME,
  authorJsonLd,
  organizationJsonLd,
} from "../../lib/site.ts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const hasBody = Boolean(post.data.body?.trim());
const articleMarkdown = stripMarkdownSections(post.data.body, [
  "Explore further",
  "What to explore next",
  "Sources",
]);
const bodyHtml = hasBody ? renderMarkdown(articleMarkdown) : "";
const notes = (await getCollection("posts")).sort(
  (first, second) => second.data.date.getTime() - first.data.date.getTime()
);
const related = relatedPosts(post, notes);

const noteImage = post.data.image;
const noteImageFull = resolveNoteImage(noteImage, "full");

const formattedDate = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const publishedTime = post.data.date.toISOString();
const pageTitle = `${post.data.title} | ${SITE_NAME}`;
const socialImage = noteImageFull ?? topicVisual(post.data.topic);
const canonicalUrl = `${SITE_CANONICAL_ORIGIN}/posts/${post.id}/`;
const articleBody = hasBody
  ? markdownToPlain(post.data.body ?? "")
  : `${post.data.excerpt}\n\n${post.data.whyItMatters}`;

const author = authorJsonLd();
const publisher = organizationJsonLd();

const articleJsonLd = {
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  headline: post.data.title,
  name: post.data.title,
  description: post.data.excerpt,
  datePublished: publishedTime,
  dateModified: publishedTime,
  url: canonicalUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  image: new URL(socialImage, Astro.site).href,
  inLanguage: "en",
  isAccessibleForFree: true,
  articleSection: post.data.topic,
  keywords: post.data.topic,
  wordCount: articleBody.split(/\s+/).filter(Boolean).length,
  author: {
    "@type": "Person",
    "@id": PERSON_ID,
    name: author.name,
    url: author.url,
    sameAs: AUTHOR_SAME_AS,
  },
  publisher: {
    "@type": "Organization",
    "@id": ORG_ID,
    name: publisher.name,
    url: publisher.url,
  },
  citation: post.data.sources.map((source) => ({
    "@type": "CreativeWork",
    name: source.label,
    url: source.url,
  })),
  articleBody,
};

const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE_NAME,
      item: `${SITE_CANONICAL_ORIGIN}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Archive",
      item: `${SITE_CANONICAL_ORIGIN}/archives/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={post.data.excerpt}
  image={socialImage}
  imageAlt={noteImage?.alt}
  type="article"
  publishedTime={publishedTime}
  section={post.data.topic}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${SITE_CANONICAL_ORIGIN}/`}>{SITE_NAME}</a>
    <span aria-hidden="true">→</span>
    <a href={`${SITE_CANONICAL_ORIGIN}/archives/`}>Archive</a>
    <span aria-hidden="true">→</span>
    <span aria-current="page">{post.data.title}</span>
  </nav>

  <article
    class="note-page paper-plain"
    itemscope
    itemtype="https://schema.org/BlogPosting"
  >
    <header class="note-header">
      <p class="eyebrow">{post.data.topic}</p>

      <h1 itemprop="headline">{post.data.title}</h1>

      <div class="meta">
        <p>
          <strong>Published:</strong>
          <time datetime={publishedTime} itemprop="datePublished">
            {formattedDate}
          </time>
        </p>

        <p>
          <strong>Written by:</strong>
          <a href={`${SITE_CANONICAL_ORIGIN}/about/`} rel="author">
            <span itemprop="author">{SITE_AUTHOR}</span>
          </a>
        </p>

        <p>
          <strong>Topic:</strong>
          {post.data.topic}
        </p>

        <p>
          <strong>Freshness:</strong>
          {post.data.freshness}
        </p>
      </div>
    </header>

    {
      noteImage && noteImageFull && (
        <figure class="note-figure">
          <img src={noteImageFull} alt={noteImage.alt} />
          <figcaption>
            <p class="note-figure-desc" aria-hidden="true">{noteImage.alt}</p>
            <p class="note-figure-credit">
              {noteImage.credit}
              <span aria-hidden="true"> · </span>
              {noteImage.license}
              {noteImage.sourceUrl && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={noteImage.sourceUrl} target="_blank" rel="noreferrer">
                    Image source
                  </a>
                </>
              )}
            </p>
          </figcaption>
        </figure>
      )
    }

    {
      hasBody ? (
        <>
          <p class="note-lede">{post.data.excerpt}</p>

          <div class="note-body" set:html={bodyHtml} />
        </>
      ) : (
        <p class="note-lede">{post.data.excerpt}</p>
      )
    }

    <section class="note-aside" aria-label="Why this note matters">
      <h2>Why it matters</h2>
      <p>{post.data.whyItMatters}</p>

      <h2>Sources</h2>
      <p class="sources-lede">
        Primary papers, institutions, and reports behind this note. Treat these
        as the authority for technical claims.
      </p>

      <ul class="note-sources">
        {
          post.data.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noreferrer">
                {source.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

  </article>

  <RelatedNotes notes={related} />
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    max-width: 48rem;
    margin: 0 auto 18px;
    color: var(--text-faint);
    font: 600 0.78rem/1.45 Arial, sans-serif;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs [aria-current="page"] {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .note-page {
    max-width: 48rem;
    padding: 28px 32px 36px;
    background-color: var(--reading-bg);
    background-image: none;
    border: 1px solid var(--border);
    border-radius: 10px 16px 12px 8px;
    box-shadow:
      0 0 0 22px var(--reading-halo),
      var(--shadow);
  }

  .note-header h1 {
    margin: 16px 0 24px;
    font-size: clamp(2.05rem, 5.4vw, 3.35rem);
    line-height: 1.08;
  }

  .note-lede {
    margin: 28px 0 0;
    color: var(--reading-heading);
    font-size: 1.22rem;
    line-height: 1.7;
  }

  .note-figure {
    margin: 6px 0 0;
  }

  .note-figure img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 34rem;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .note-figure-desc,
  .note-figure-credit {
    margin: 10px 0 0;
    font-family: Arial, sans-serif;
    line-height: 1.45;
  }

  .note-figure-desc {
    color: var(--reading-ink);
    font-size: 0.92rem;
  }

  .note-figure-credit {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .note-figure a {
    color: var(--accent-strong);
    text-underline-offset: 2px;
  }

  .note-body {
    margin-top: 8px;
  }

  .note-body :global(h2),
  .note-aside h2 {
    margin: 2.35rem 0 0.8rem;
    color: var(--reading-heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.28;
    text-transform: none;
  }

  .note-body :global(h3) {
    margin: 1.8rem 0 0.7rem;
    color: var(--reading-heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.16rem;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .note-body :global(p),
  .note-aside p {
    margin: 0 0 1.15rem;
    color: var(--reading-ink);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .sources-lede {
    color: var(--text-faint) !important;
    font-size: 0.98rem !important;
  }

  .note-body :global(em),
  .note-body :global(i) {
    color: var(--heading);
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin: 0 0 1.2rem;
    padding-left: 1.3rem;
    color: var(--reading-ink);
  }

  .note-body :global(li) {
    margin: 0 0 0.45rem;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .note-aside {
    margin-top: 3.2rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  .note-sources {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note-sources li {
    padding: 12px 14px;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .note-sources a {
    color: var(--accent-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .note-page {
      padding: 20px 16px 28px;
    }

    .note-lede,
    .note-body :global(p),
    .note-aside p {
      font-size: 1.08rem;
    }

    .note-figure img {
      border-radius: 8px;
    }

    .note-figure-desc {
      font-size: 0.88rem;
    }
  }
</style>
