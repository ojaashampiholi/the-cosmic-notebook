---
import { getCollection } from "astro:content";
import NotebookCard from "../../components/NotebookCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { scatterSpans } from "../../lib/paper.ts";
import { parseTopics } from "../../lib/posts.ts";
import {
  SITE_CANONICAL_ORIGIN,
  SITE_NAME,
  WEBSITE_ID,
} from "../../lib/site.ts";
import {
  topicDescription,
  topicHref,
  topicSlug,
  topicUrl,
} from "../../lib/topics.ts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const topics = [
    ...new Set(posts.flatMap((post) => parseTopics(post.data.topic))),
  ].sort((first, second) => first.localeCompare(second));

  return topics.map((topic) => ({
    params: {
      slug: topicSlug(topic),
    },
    props: {
      topic,
    },
  }));
}

const { topic } = Astro.props as { topic: string };
const allPosts = (await getCollection("posts")).sort(
  (first, second) => second.data.date.getTime() - first.data.date.getTime()
);
const topicPosts = allPosts.filter((post) =>
  parseTopics(post.data.topic).includes(topic)
);
const otherTopics = [
  ...new Set(allPosts.flatMap((post) => parseTopics(post.data.topic))),
]
  .filter((item) => item !== topic)
  .sort((first, second) => first.localeCompare(second));

const spans = scatterSpans(topicPosts.length, false);
const description = topicDescription(topic);
const canonicalUrl = topicUrl(topic);

const collectionJsonLd = {
  "@type": "CollectionPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: `${topic} | ${SITE_NAME}`,
  headline: topic,
  description,
  inLanguage: "en",
  isPartOf: {
    "@id": WEBSITE_ID,
  },
  about: {
    "@type": "Thing",
    name: topic,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: topicPosts.length,
    itemListElement: topicPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "BlogPosting",
        "@id": `${SITE_CANONICAL_ORIGIN}/posts/${post.id}/`,
        url: `${SITE_CANONICAL_ORIGIN}/posts/${post.id}/`,
        name: post.data.title,
      },
    })),
  },
};

const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE_NAME,
      item: `${SITE_CANONICAL_ORIGIN}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: topic,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${topic} | ${SITE_NAME}`}
  description={description}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${SITE_CANONICAL_ORIGIN}/`}>{SITE_NAME}</a>
    <span aria-hidden="true">→</span>
    <span aria-current="page">{topic}</span>
  </nav>

  <header class="topic-header">
    <p class="eyebrow">Topic notebook</p>
    <h1>{topic}</h1>
    <p class="topic-intro">{description}</p>
    <p class="topic-count">
      {topicPosts.length} published {topicPosts.length === 1 ? "note" : "notes"}
      in this topic.
    </p>
  </header>

  <section aria-labelledby="topic-notes-heading">
    <div class="filter-heading">
      <div>
        <p class="eyebrow">Notes in this field</p>
        <h2 id="topic-notes-heading">From newest to oldest</h2>
      </div>
    </div>

    <ul class="notebook-scatter topic-notes">
      {
        topicPosts.map((post, index) => (
          <NotebookCard
            post={post}
            rank={index + 1}
            context="archive"
            span={spans[index]}
          />
        ))
      }
    </ul>
  </section>

  <nav class="other-topics" aria-labelledby="other-topics-heading">
    <p class="eyebrow">Keep exploring</p>
    <h2 id="other-topics-heading">Other topic notebooks</h2>
    <div class="other-topic-links">
      {
        otherTopics.map((otherTopic) => (
          <a href={topicHref(otherTopic)}>{otherTopic}</a>
        ))
      }
    </div>
  </nav>
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin: 0 0 18px;
    color: var(--text-faint);
    font: 600 0.78rem/1.45 Arial, sans-serif;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topic-header {
    max-width: 52rem;
    margin-bottom: 52px;
  }

  .topic-header h1 {
    margin-bottom: 14px;
  }

  .topic-intro {
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .topic-count {
    margin-top: 16px;
    color: var(--text-faint);
    font: 700 0.78rem/1.45 Arial, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .topic-notes {
    margin-top: 22px;
  }

  .other-topics {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .other-topics h2 {
    margin: 0 0 18px;
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.55rem;
    text-transform: none;
  }

  .other-topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .other-topic-links a {
    padding: 8px 11px;
    color: var(--accent);
    background: var(--bg-chip);
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 700 0.76rem/1.2 Arial, sans-serif;
    text-decoration: none;
  }

  .other-topic-links a:hover {
    border-color: var(--border-strong);
  }
</style>
