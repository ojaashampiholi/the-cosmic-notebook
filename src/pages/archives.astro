---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NotebookCard from "../components/NotebookCard.astro";
import { scatterSpans } from "../lib/paper.ts";
import { parseTopics } from "../lib/posts.ts";
import { SITE_NAME } from "../lib/site.ts";

const allPosts = (await getCollection("posts")).sort(
  (first, second) => second.data.date.getTime() - first.data.date.getTime()
);

const archivePosts = allPosts.slice(10);
const pageSize = 30;
const spans = scatterSpans(archivePosts.length, false);

const topics = [
  ...new Set(
    archivePosts.flatMap((post) =>
      parseTopics(post.data.topic)
    )
  ),
].sort((first, second) => first.localeCompare(second));

const topicCounts = new Map(
  topics.map((topic) => [
    topic,
    archivePosts.filter((post) =>
      parseTopics(post.data.topic).includes(topic)
    ).length,
  ])
);
---

<BaseLayout
  title={`Archive | ${SITE_NAME}`}
  description={`Browse earlier source-linked astronomy, physics, planetary science, cosmology, and space-mission notes from ${SITE_NAME}.`}
>
  <p class="eyebrow">The archive</p>
  <h1>Earlier discoveries</h1>

  <p>
    Notes that have moved beyond the latest ten discoveries, kept here for
    readers who want to keep exploring.
  </p>

  <section class="topic-filter-section" data-archive-browser>
    <div class="filter-heading">
      <div>
        <p class="eyebrow">Browse the archive</p>
        <h2>Follow a field of curiosity further back</h2>
      </div>
    </div>

    <div class="topic-filters" role="group" aria-label="Filter archive by topic">
      <button
        class="topic-filter is-active"
        type="button"
        data-filter-all
        aria-pressed="true"
      >
        All archive notes <span>{archivePosts.length}</span>
      </button>

      {
        topics.map((topic) => (
          <button
            class="topic-filter"
            type="button"
            data-topic-filter={topic}
            aria-pressed="false"
          >
            {topic} <span>{topicCounts.get(topic)}</span>
          </button>
        ))
      }
    </div>

    <p class="filter-status" data-filter-status aria-live="polite">
      Showing all archive notes.
    </p>

    <ul class="notebook-scatter">
      {
        archivePosts.map((post, index) => (
          <NotebookCard
            post={post}
            rank={index + 1}
            context="archive"
            span={spans[index]}
            hidden={index >= pageSize}
          />
        ))
      }
    </ul>

    <p class="empty-state" data-empty-state hidden>
      No archive notes match those topics yet.
    </p>

    <nav class="pagination" data-pagination aria-label="Archive pages"></nav>
  </section>
</BaseLayout>

<script>
  const browser = document.querySelector<HTMLElement>(
    "[data-archive-browser]"
  )!;

  if (browser) {
    const postCards = Array.from(
      browser.querySelectorAll<HTMLElement>("[data-post-card]")
    );
    const topicButtons = Array.from(
      browser.querySelectorAll<HTMLButtonElement>("[data-topic-filter]")
    );
    const allPostsButton = browser.querySelector<HTMLButtonElement>(
      "[data-filter-all]"
    );
    const filterStatus = browser.querySelector<HTMLElement>(
      "[data-filter-status]"
    );
    const emptyState = browser.querySelector<HTMLElement>("[data-empty-state]");
    const selectedTopics = new Set<string>();
    const pageSize = 30;
    const initialParameters = new URLSearchParams(window.location.search);
    let currentPage = Number(initialParameters.get("page") ?? "1");

    if (!Number.isInteger(currentPage) || currentPage < 1) {
      currentPage = 1;
    }

    const requestedTopics = initialParameters
      .get("topics")
      ?.split(",")
      .filter(Boolean);

    requestedTopics?.forEach((topic) => {
      if (topicButtons.some((button) => button.dataset.topicFilter === topic)) {
        selectedTopics.add(topic);
      }
    });

    function cardMatchesSelectedTopics(card: HTMLElement) {
      if (selectedTopics.size === 0) {
        return true;
      }

      const cardTopics = JSON.parse(card.dataset.topics ?? "[]") as string[];
      return cardTopics.some((topic) => selectedTopics.has(topic));
    }

    function setCardVisibility(card: HTMLElement, isVisible: boolean) {
      card.hidden = !isVisible;
      card.style.setProperty(
        "display",
        isVisible ? "flex" : "none",
        "important"
      );
    }

    function paginationItems(totalPages: number) {
      if (totalPages <= 7) {
        return Array.from({ length: totalPages }, (_, index) => index + 1);
      }

      const pages = new Set([1, totalPages, currentPage]);

      if (currentPage > 1) {
        pages.add(currentPage - 1);
      }

      if (currentPage < totalPages) {
        pages.add(currentPage + 1);
      }

      const sortedPages = [...pages].sort((first, second) => first - second);
      const items: Array<number | "ellipsis"> = [];

      sortedPages.forEach((page, index) => {
        if (index > 0 && page - sortedPages[index - 1] > 1) {
          items.push("ellipsis");
        }

        items.push(page);
      });

      return items;
    }

    function renderPagination(container: HTMLElement, totalPages: number) {
      container.replaceChildren();
      container.hidden = totalPages <= 1;

      if (totalPages <= 1) {
        return;
      }

      const addPageButton = (
        label: string,
        page: number,
        options: {
          current?: boolean;
          disabled?: boolean;
          className?: string;
        } = {}
      ) => {
        const button = document.createElement("button");

        button.type = "button";
        button.className = `pagination-button ${options.className ?? ""}`.trim();
        button.textContent = label;
        button.disabled = Boolean(options.disabled);
        button.setAttribute("aria-label", `${label} archive page`);

        if (options.current) {
          button.classList.add("is-active");
          button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
          currentPage = page;
          applyFilters();
          window.scrollTo({
            top: browser.offsetTop,
            behavior: "smooth",
          });
        });

        container.append(button);
      };

      addPageButton("Previous", currentPage - 1, {
        disabled: currentPage === 1,
        className: "pagination-direction",
      });

      paginationItems(totalPages).forEach((item) => {
        if (item === "ellipsis") {
          const ellipsis = document.createElement("span");
          ellipsis.className = "pagination-ellipsis";
          ellipsis.textContent = "…";
          ellipsis.setAttribute("aria-hidden", "true");
          container.append(ellipsis);
          return;
        }

        addPageButton(String(item), item, {
          current: item === currentPage,
        });
      });

      addPageButton("Next", currentPage + 1, {
        disabled: currentPage === totalPages,
        className: "pagination-direction",
      });
    }

    function applyFilters() {
      const matchingCards = postCards.filter(cardMatchesSelectedTopics);
      const totalPages = Math.max(1, Math.ceil(matchingCards.length / pageSize));

      currentPage = Math.min(Math.max(1, currentPage), totalPages);

      postCards.forEach((card) => {
        setCardVisibility(card, false);
      });

      matchingCards
        .slice((currentPage - 1) * pageSize, currentPage * pageSize)
        .forEach((card) => {
          setCardVisibility(card, true);
        });

      topicButtons.forEach((button) => {
        const topic = button.dataset.topicFilter ?? "";
        const isSelected = selectedTopics.has(topic);
        button.classList.toggle("is-active", isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
      });

      const showingAllPosts = selectedTopics.size === 0;

      if (allPostsButton) {
        allPostsButton.classList.toggle("is-active", showingAllPosts);
        allPostsButton.setAttribute("aria-pressed", String(showingAllPosts));
      }

      if (emptyState) {
        emptyState.hidden = matchingCards.length !== 0;
      }

      if (filterStatus) {
        if (matchingCards.length === 0) {
          filterStatus.textContent = "No archive notes found.";
        } else {
          const firstVisibleNumber = (currentPage - 1) * pageSize + 1;
          const lastVisibleNumber = Math.min(
            currentPage * pageSize,
            matchingCards.length
          );

          filterStatus.textContent =
            `Showing notes ${firstVisibleNumber}–${lastVisibleNumber} ` +
            `of ${matchingCards.length}.`;
        }
      }

      const parameters = new URLSearchParams();

      if (selectedTopics.size > 0) {
        parameters.set("topics", [...selectedTopics].join(","));
      }

      if (currentPage > 1) {
        parameters.set("page", String(currentPage));
      }

      const nextUrl = parameters.size
        ? `${window.location.pathname}?${parameters.toString()}`
        : window.location.pathname;

      window.history.replaceState({}, "", nextUrl);

      const robotsMeta = document.querySelector<HTMLMetaElement>(
        'meta[name="robots"]'
      );

      if (robotsMeta) {
        robotsMeta.content =
          selectedTopics.size > 0 ? "noindex, follow" : "index, follow";
      }

      const pagination = browser.querySelector<HTMLElement>("[data-pagination]");

      if (pagination) {
        renderPagination(pagination, totalPages);
      }
    }

    allPostsButton?.addEventListener("click", () => {
      selectedTopics.clear();
      currentPage = 1;
      applyFilters();
    });

    topicButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const topic = button.dataset.topicFilter;

        if (!topic) {
          return;
        }

        if (selectedTopics.has(topic)) {
          selectedTopics.delete(topic);
        } else {
          selectedTopics.add(topic);
        }

        currentPage = 1;
        applyFilters();
      });
    });

    applyFilters();
  }
</script>
