---
import NotebookCard from "./NotebookCard.astro";
import type { NotebookPost } from "../lib/posts.ts";

const { notes } = Astro.props as {
  notes: NotebookPost[];
};
---

{
  notes.length > 0 && (
    <nav class="related-notes" aria-labelledby="related-notes-heading">
      <p class="eyebrow">Keep reading</p>
      <h2 id="related-notes-heading">Related notes</h2>
      <p class="related-lede">
        {notes.length === 1
          ? "One other note. Shared topics come first; a recent note fills the gap when it has to."
          : `${notes.length} other notes. Shared topics come first. Recent notes fill whatever is left.`}
      </p>

      <ul class="related-grid">
        {notes.map((note) => (
          <NotebookCard post={note} context="related" span={1} rank={4} />
        ))}
      </ul>
    </nav>
  )
}

<style>
  .related-notes {
    width: 100%;
    margin-top: 2.6rem;
  }

  .related-notes .eyebrow {
    margin: 0 0 8px;
  }

  .related-notes h2 {
    margin: 0 0 0.45rem;
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.45rem, 2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-transform: none;
  }

  .related-lede {
    max-width: 42rem;
    margin: 0 0 1.1rem;
    color: var(--card-ink);
    font-size: 1rem;
    line-height: 1.55;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .related-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
