---
import { parseTopics } from "../lib/posts.ts";
import { postHref } from "../lib/site.ts";
import type { NotebookPost } from "../lib/posts.ts";

const { notes } = Astro.props as {
  notes: NotebookPost[];
};

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

{
  notes.length > 0 && (
    <nav class="related-notes" aria-labelledby="related-notes-heading">
      <p class="eyebrow">Keep reading</p>
      <h2 id="related-notes-heading">Related notes</h2>

      <ul>
        {
          notes.map((note) => (
            <li>
              <a href={postHref(note.id)}>
                <span class="related-title">{note.data.title}</span>
                <span class="related-meta">
                  {parseTopics(note.data.topic).join(" · ")}
                  <span aria-hidden="true"> · </span>
                  {formatDate(note.data.date)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}

<style>
  .related-notes {
    margin-top: 3.2rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  .related-notes .eyebrow {
    margin: 0 0 8px;
  }

  .related-notes h2 {
    margin: 0 0 1.1rem;
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.28;
    text-transform: none;
  }

  .related-notes ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-notes a {
    display: grid;
    gap: 0.35rem;
    padding: 14px 16px;
    color: inherit;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .related-notes a:hover {
    background: var(--bg-chip);
    border-color: var(--border-strong);
  }

  .related-title {
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.28;
  }

  .related-meta {
    color: var(--text-faint);
    font: 0.82rem/1.45 Arial, sans-serif;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-notes a {
      transition: none;
    }
  }
</style>
