---
import { parseTopics } from "../lib/posts.ts";
import {
  paperDetailForId,
  paperShiftForId,
  paperTiltForId,
  paperTypeForId,
} from "../lib/paper.ts";
import { postHref } from "../lib/site.ts";

const {
  post,
  rank = 4,
  context = "archive",
  hidden = false,
  span = 2,
} = Astro.props as {
  post: {
    id: string;
    data: {
      title: string;
      topic: string;
      date: Date;
      excerpt: string;
    };
  };
  rank?: number;
  context?: "homepage" | "archive";
  hidden?: boolean;
  span?: number;
};

const topics = parseTopics(post.data.topic);
const paper = paperTypeForId(post.id);
const detail = paperDetailForId(post.id);
const tilt = paperTiltForId(post.id);
const shift = paperShiftForId(post.id);
const isHero = context === "homepage" && rank === 1;
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<li
  class:list={[
    "notebook-card-wrap",
    `shift-${shift}`,
    { "is-hero": isHero },
  ]}
  data-post-card
  data-topics={JSON.stringify(topics)}
  hidden={hidden}
  style={`--paper-tilt: ${tilt}deg; --card-span: ${span};`}
>
  <a class:list={["notebook-card", `paper-${paper}`, `detail-${detail}`]} href={postHref(post.id)}>
    <span class="topic-chip-list" aria-label="Post topics">
      {
        topics.map((topic) => (
          <span class="topic-chip">{topic}</span>
        ))
      }
    </span>

    <h2>{post.data.title}</h2>
    <p class="tease">{post.data.excerpt}</p>
    <p class="card-meta">
      <time datetime={post.data.date.toISOString()}>{date}</time>
      <span aria-hidden="true"> · </span>
      <span>Open note</span>
    </p>
  </a>
</li>

<style>
  .notebook-card-wrap {
    display: flex;
    grid-column: span var(--card-span, 2);
    min-width: 0;
  }

  .notebook-card-wrap[hidden] {
    display: none !important;
  }

  .notebook-card-wrap.is-hero {
    grid-column: 1 / -1;
  }

  .shift-1 {
    margin-top: 10px;
  }

  .shift-2 {
    margin-top: 4px;
  }

  .notebook-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: 0;
    padding: 18px 18px 16px 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px 13px 10px 7px;
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transform: rotate(var(--paper-tilt, 0deg));
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .notebook-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(to bottom, var(--accent), #8c72cc 55%, #d49c6a);
    border-radius: 8px 0 0 7px;
    content: "";
  }

  .notebook-card.detail-tape::after {
    position: absolute;
    z-index: 2;
    top: -8px;
    left: 50%;
    width: 52px;
    height: 15px;
    background: var(--tape);
    border: 1px solid var(--border);
    content: "";
    transform: translateX(-50%) rotate(-1.4deg);
  }

  .notebook-card.detail-pin::after {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 12px;
    width: 8px;
    height: 8px;
    background: var(--pin);
    border: 2px solid rgba(255, 230, 214, 0.34);
    border-radius: 50%;
    box-shadow: 0 3px 7px rgba(0, 0, 0, 0.28);
    content: "";
  }

  .notebook-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
    transform:
      translateY(-4px)
      rotate(calc(var(--paper-tilt, 0deg) * -0.35));
  }

  .is-hero .notebook-card {
    padding: 26px 28px 22px 32px;
    min-height: 0;
  }

  .topic-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .topic-chip {
    padding: 4px 7px;
    color: var(--accent);
    background: var(--bg-chip);
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 700 0.64rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
  }

  h2 {
    margin: 0 0 8px;
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.12rem, 1.8vw, 1.38rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.18;
    text-transform: none;
  }

  .is-hero h2 {
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    margin-bottom: 10px;
  }

  .tease {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    line-clamp: 3;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .is-hero .tease {
    font-size: 1.02rem;
    line-height: 1.55;
    line-clamp: 4;
    -webkit-line-clamp: 4;
  }

  .card-meta {
    margin: 12px 0 0;
    color: var(--text-faint);
    font: 700 0.72rem/1.4 Arial, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .notebook-card-wrap {
      grid-column: span 3;
      margin-top: 0;
    }

    .notebook-card-wrap.is-hero {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .notebook-card-wrap,
    .notebook-card-wrap.is-hero {
      grid-column: 1 / -1;
    }

    .notebook-card {
      padding: 18px 16px 16px 20px;
      border-radius: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notebook-card,
    .notebook-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>
