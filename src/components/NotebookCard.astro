---
const {
  post,
  rank = 4,
  context = "archive",
  hidden = false,
} = Astro.props as any;

const topics = post.data.topic
  .split("/")
  .map((value: string) => value.trim())
  .filter(Boolean);

const primary = post.data.sources[0];

const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const hash = [...post.id].reduce(
  (sum, value) => sum + value.charCodeAt(0),
  0
);

const paper = ["lined", "graph", "plain"][hash % 3];
const detail = ["plain", "tape", "plain", "pin"][hash % 4];
const tilt = ((hash % 5) - 2) * 0.18;

const placement =
  rank === 1
    ? "feature"
    : rank <= 3
      ? "supporting"
      : "masonry";
---

<li
  class:list={[
    "post-card",
    "notebook-card",
    `notebook-card--${context}`,
    `notebook-card--${placement}`,
    `notebook-card--rank-${rank}`,
    `paper-${paper}`,
    `detail-${detail}`,
  ]}
  data-post-card
  data-topics={JSON.stringify(topics)}
  hidden={hidden}
  style={`--paper-tilt: ${tilt}deg`}
>
  <div class="post-card-content">
    <div class="topic-chip-list" aria-label="Post topics">
      {
        topics.map((topic: string) => (
          <span class="topic-chip">{topic}</span>
        ))
      }
    </div>

    <h2>
      {
        primary ? (
          <a
            href={primary.url}
            target="_blank"
            rel="noreferrer"
            title={`Open source: ${primary.label}`}
          >
            {post.data.title}
          </a>
        ) : (
          post.data.title
        )
      }
    </h2>

    <p class="eyebrow">Published</p>
    <p class="card-value">{date}</p>

    <p class="eyebrow">Freshness</p>
    <p class="card-value">{post.data.freshness}</p>

    <p class="eyebrow">Summary</p>
    <p class="card-value">{post.data.excerpt}</p>

    <p class="eyebrow">Why it matters</p>
    <p class="card-value">{post.data.whyItMatters}</p>

    <p class="eyebrow">Sources</p>

    <ul class="source-list">
      {
        post.data.sources.map(
          (source: { url: string; label: string }) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noreferrer"
              >
                {source.label}
              </a>
            </li>
          )
        )
      }
    </ul>
  </div>
</li>

<style>
  .post-card {
    position: relative;
    display: flex;
    min-width: 0;
    height: 100%;
    padding: clamp(28px, 4vw, 44px);
    overflow: visible;
    background-color: #131d30;
    background-image:
      radial-gradient(
        circle at 22% 16%,
        rgba(255, 255, 255, 0.055),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.045),
        transparent 44%
      );
    border: 1px solid rgba(179, 194, 232, 0.28);
    border-radius: 9px 15px 11px 8px;
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.065);
    transform: rotate(var(--paper-tilt, 0deg));
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .post-card[hidden] {
    display: none !important;
  }

  .post-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  .post-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      #aebdff,
      #8c72cc 55%,
      #d49c6a
    );
    border-radius: 9px 0 0 8px;
    content: "";
  }

  .post-card.paper-lined {
    background-image:
      linear-gradient(
        90deg,
        transparent 0 34px,
        rgba(205, 125, 133, 0.11) 34px 35px,
        transparent 35px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0 31px,
        rgba(174, 189, 255, 0.1) 31px 32px
      ),
      radial-gradient(
        circle at 22% 16%,
        rgba(255, 255, 255, 0.05),
        transparent 34%
      );
  }

  .post-card.paper-graph {
    background-image:
      linear-gradient(
        rgba(174, 189, 255, 0.075) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(174, 189, 255, 0.075) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 22% 16%,
        rgba(255, 255, 255, 0.05),
        transparent 34%
      );
    background-size:
      28px 28px,
      28px 28px,
      auto;
  }

  .post-card.detail-tape::after {
    position: absolute;
    z-index: 2;
    top: -9px;
    left: 50%;
    width: 64px;
    height: 19px;
    background: rgba(208, 194, 158, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    content: "";
    transform: translateX(-50%) rotate(-1.4deg);
  }

  .post-card.detail-pin::after {
    position: absolute;
    z-index: 2;
    top: 15px;
    right: 18px;
    width: 9px;
    height: 9px;
    background: #bc856f;
    border: 2px solid rgba(255, 230, 214, 0.34);
    border-radius: 50%;
    box-shadow: 0 3px 7px rgba(0, 0, 0, 0.38);
    content: "";
  }

  .post-card:hover {
    border-color: rgba(174, 189, 255, 0.5);
    box-shadow: 0 23px 52px rgba(0, 0, 0, 0.4);
    transform:
      translateY(-5px)
      rotate(calc(var(--paper-tilt, 0deg) * -0.45));
  }

  .notebook-card--feature {
    width: 100%;
  }

  .notebook-card--feature h2 {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
  }

  .notebook-card--supporting,
  .notebook-card--masonry {
    height: auto;
  }

  .notebook-card--masonry {
    width: 100%;
    margin: 0 0 26px;
    break-inside: avoid;
  }

  .topic-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
  }

  .topic-chip {
    padding: 5px 8px;
    color: #bdc9ff;
    background: rgba(174, 189, 255, 0.1);
    border: 1px solid rgba(174, 189, 255, 0.2);
    border-radius: 999px;
    font: 700 0.68rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
  }

  h2 {
    margin: 0 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.7rem, 3.5vw, 2.45rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-transform: none;
  }

  h2 a {
    color: #f1f4fb;
    text-decoration: none;
  }

  h2 a:hover,
  .source-list a:hover {
    color: #b9c6ff;
  }

  .eyebrow {
    margin: 0 0 4px;
    color: #aebdff;
  }

  .card-value {
    margin: 3px 0 22px;
    color: #c4ccdc;
  }

  .source-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 7px 0 0;
    padding: 0;
    list-style: none;
  }

  .source-list li {
    padding: 0;
    border: 0;
    font: inherit;
  }

  .source-list li:not(:last-child)::after {
    margin: 0 0.55rem;
    color: #6f7b98;
    content: "·";
  }

  .source-list a {
    color: #c7d1ff;
    font: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .post-card-content {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    .post-card {
      padding: 28px 24px 30px;
      border-radius: 12px;
    }

    .notebook-card--feature h2 {
      font-size: clamp(1.9rem, 9vw, 2.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>