---
import type { NoteImage } from "../lib/note-image.ts";
import { resolveNoteImage } from "../lib/note-image.ts";
import { parseTopics } from "../lib/posts.ts";
import {
  paperDetailForId,
  paperShiftForId,
  paperTiltForId,
  paperTypeForId,
} from "../lib/paper.ts";
import { postHref } from "../lib/site.ts";

const {
  post,
  rank = 4,
  context = "archive",
  hidden = false,
  span = 2,
} = Astro.props as {
  post: {
    id: string;
    data: {
      title: string;
      topic: string;
      date: Date;
      excerpt: string;
      image?: NoteImage;
    };
  };
  rank?: number;
  context?: "homepage" | "archive" | "related";
  hidden?: boolean;
  span?: number;
};

const topics = parseTopics(post.data.topic);
const paper = paperTypeForId(post.id);
const detail = paperDetailForId(post.id);
const isRelated = context === "related";
const tilt = isRelated ? 0 : paperTiltForId(post.id);
const shift = isRelated ? 0 : paperShiftForId(post.id);
const isHero = context === "homepage" && rank === 1;
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const noteImage = post.data.image;
const thumbSrc = resolveNoteImage(noteImage, "thumb");
---

<li
  class:list={[
    "notebook-card-wrap",
    `shift-${shift}`,
    {
      "is-hero": isHero,
      "is-home": context === "homepage",
      "is-related": isRelated,
    },
  ]}
  data-post-card
  data-topics={JSON.stringify(topics)}
  hidden={hidden}
  style={`--paper-tilt: ${tilt}deg; --card-span: ${span};`}
>
  <a class:list={["notebook-card", `paper-${paper}`, `detail-${detail}`]} href={postHref(post.id)}>
    {isHero && <span class="hero-kicker">Newest note</span>}
    <span class="topic-chip-list" aria-label="Post topics">
      {
        topics.map((topic) => (
          <span class="topic-chip">{topic}</span>
        ))
      }
    </span>

    {
      thumbSrc && noteImage && (
        <span class="card-thumb">
          <img src={thumbSrc} alt="" />
        </span>
      )
    }

    <h2>{post.data.title}</h2>
    <p class="tease">{post.data.excerpt}</p>
    <p class="card-meta">
      <time datetime={post.data.date.toISOString()}>{date}</time>
      <span aria-hidden="true"> · </span>
      <span>Open note</span>
    </p>
    {
      noteImage && (
        <p class="card-credit">
          {noteImage.credit}
          <span aria-hidden="true"> · </span>
          {noteImage.license}
        </p>
      )
    }
  </a>
</li>

<style>
  .notebook-card-wrap {
    display: flex;
    grid-column: span var(--card-span, 2);
    min-width: 0;
  }

  .notebook-card-wrap[hidden] {
    display: none !important;
  }

  .notebook-card-wrap.is-hero {
    grid-column: 1 / -1;
  }

  .shift-1 {
    margin-top: 10px;
  }

  .shift-2 {
    margin-top: 4px;
  }

  .notebook-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: 0;
    padding: 18px 18px 16px 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px 13px 10px 7px;
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transform: rotate(var(--paper-tilt, 0deg));
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .notebook-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(to bottom, var(--accent), #8c72cc 55%, #d49c6a);
    border-radius: 8px 0 0 7px;
    content: "";
  }

  .notebook-card.detail-tape::after {
    position: absolute;
    z-index: 2;
    top: -8px;
    left: 50%;
    width: 52px;
    height: 15px;
    background: var(--tape);
    border: 1px solid var(--border);
    content: "";
    transform: translateX(-50%) rotate(-1.4deg);
  }

  .notebook-card.detail-pin::after {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 12px;
    width: 8px;
    height: 8px;
    background: var(--pin);
    border: 2px solid rgba(255, 230, 214, 0.34);
    border-radius: 50%;
    box-shadow: 0 3px 7px rgba(0, 0, 0, 0.28);
    content: "";
  }

  .notebook-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
    transform:
      translateY(-4px)
      rotate(calc(var(--paper-tilt, 0deg) * -0.35));
  }

  .is-hero .notebook-card {
    padding: 26px 28px 22px 32px;
    min-height: 0;
  }

  .topic-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .card-thumb {
    display: block;
    margin: 0 0 12px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .card-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .is-hero .card-thumb {
    aspect-ratio: 2 / 1;
    margin-bottom: 14px;
  }

  .notebook-card-wrap.is-related .card-thumb {
    aspect-ratio: 16 / 9;
    margin-bottom: 10px;
  }

  .topic-chip {
    padding: 4px 7px;
    color: var(--accent);
    background: var(--bg-chip);
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 700 0.64rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
  }

  h2 {
    margin: 0 0 8px;
    color: var(--heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.12rem, 1.8vw, 1.38rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.18;
    text-transform: none;
  }

  .is-hero h2 {
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    margin-bottom: 10px;
  }

  .hero-kicker {
    display: none;
  }

  .tease {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--card-ink);
    font-size: 0.92rem;
    line-height: 1.5;
    line-clamp: 3;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .is-hero .tease {
    font-size: 1.02rem;
    line-height: 1.55;
    line-clamp: 4;
    -webkit-line-clamp: 4;
  }

  .card-meta {
    margin: 12px 0 0;
    color: var(--text-faint);
    font: 700 0.72rem/1.4 Arial, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-credit {
    margin: 8px 0 0;
    color: var(--text-muted);
    font: 600 0.68rem/1.35 Arial, sans-serif;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .notebook-card-wrap {
      grid-column: span 3;
      margin-top: 0;
    }

    .notebook-card-wrap.is-hero {
      grid-column: 1 / -1;
    }
  }

  .notebook-card-wrap.is-related {
    grid-column: auto;
    margin-top: 0;
  }

  .notebook-card-wrap.is-related .notebook-card,
  .notebook-card-wrap.is-related .notebook-card:hover {
    min-height: 0;
    padding: 16px 14px 14px 18px;
    transform: none;
  }

  .notebook-card-wrap.is-related h2 {
    font-size: 1.05rem;
  }

  .notebook-card-wrap.is-related .tease {
    font-size: 0.86rem;
    line-clamp: 3;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 700px) {
    .notebook-card-wrap.is-home {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .notebook-card-wrap.is-home .notebook-card,
    .notebook-card-wrap.is-home .notebook-card:hover {
      transform: none;
    }

    .notebook-card-wrap.is-home.is-hero {
      margin-bottom: 6px;
    }

    .notebook-card-wrap.is-home.is-hero .hero-kicker {
      display: inline-block;
      margin-bottom: 10px;
      padding: 4px 8px;
      color: var(--heading);
      background: var(--bg-chip);
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      font: 700 0.68rem/1 Arial, sans-serif;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .notebook-card-wrap.is-home.is-hero .notebook-card {
      padding: 26px 20px 22px 24px;
      border-width: 1.5px;
      border-color: var(--border-strong);
      box-shadow: var(--shadow-hover);
    }

    .notebook-card-wrap.is-home.is-hero h2 {
      font-size: clamp(1.65rem, 7.4vw, 2.15rem);
      line-height: 1.12;
    }

    .notebook-card-wrap.is-home.is-hero .tease {
      font-size: 1.05rem;
      line-height: 1.55;
      line-clamp: 6;
      -webkit-line-clamp: 6;
    }

    .notebook-card-wrap.is-home:not(.is-hero) .notebook-card {
      padding: 14px 14px 12px 16px;
      border-radius: 10px;
    }

    .notebook-card-wrap.is-home:not(.is-hero) .notebook-card::after {
      display: none;
    }

    .notebook-card-wrap.is-home:not(.is-hero) h2 {
      font-size: 1.08rem;
    }

    .notebook-card-wrap.is-home:not(.is-hero) .tease {
      font-size: 0.88rem;
      line-clamp: 2;
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 600px) {
    .notebook-card-wrap,
    .notebook-card-wrap.is-hero {
      grid-column: 1 / -1;
    }

    .notebook-card {
      padding: 18px 16px 16px 20px;
      border-radius: 12px;
    }

    .notebook-card-wrap.is-home.is-hero .notebook-card {
      padding: 26px 20px 22px 24px;
      border-radius: 14px;
    }

    .notebook-card-wrap.is-home:not(.is-hero) .notebook-card {
      padding: 14px 14px 12px 16px;
      border-radius: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notebook-card,
    .notebook-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>
