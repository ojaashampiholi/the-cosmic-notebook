---
import { postHref } from "../lib/site.ts";

const { post } = Astro.props as {
  post: {
    id: string;
    data: {
      body?: string;
      sources: Array<{
        label: string;
        url: string;
      }>;
    };
  };
};

const hasBody = Boolean(post.data.body?.trim());
const primarySource = post.data.sources[0];
---

<p class="note-links">
  {
    hasBody && (
      <span class="fuller-chip">Fuller note</span>
    )
  }
  <a class="read-note" href={postHref(post.id)}>
    {hasBody ? "Read the full note" : "Read the note"}
  </a>
  {
    primarySource && (
      <a
        class="primary-source"
        href={primarySource.url}
        target="_blank"
        rel="noreferrer"
        title={primarySource.label}
      >
        Primary source
      </a>
    )
  }
</p>

<style>
  .note-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin: 4px 0 22px;
  }

  .fuller-chip {
    padding: 5px 8px;
    color: #f1d4ae;
    background: rgba(212, 156, 106, 0.12);
    border: 1px solid rgba(241, 212, 174, 0.28);
    border-radius: 999px;
    font: 700 0.68rem/1 Arial, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .read-note {
    color: #f1f4fb;
    font: 700 0.98rem/1.4 Arial, sans-serif;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .read-note:hover {
    color: #e8edff;
  }

  .primary-source {
    color: #8f9bb7;
    font: 0.82rem/1.4 Arial, sans-serif;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .primary-source:hover {
    color: #c7d1ff;
  }
</style>
